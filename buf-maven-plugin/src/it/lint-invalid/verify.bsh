String log = new String(java.nio.file.Files.readAllBytes(new File(basedir, "build.log").toPath()), "UTF-8");
if (!log.contains("greeter.proto:6:10:") || !log.contains("userName") || !log.contains("[FIELD_LOWER_SNAKE_CASE]")) {
    throw new IllegalStateException("Missing buf problem in build log");
}
if (!log.contains("buf found 1 problem(s)")) {
    throw new IllegalStateException("Build did not fail because of buf problems");
}
if (!log.contains("::error file=") || !log.contains("src/main/proto/demo/v1/greeter.proto,line=6,col=10,title=buf [FIELD_LOWER_SNAKE_CASE]::")) {
    throw new IllegalStateException("Missing GitHub annotation in build log");
}
return true;